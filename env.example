# GitHub token to raise API search limits (10/min anonymous → 30/min authed)
GITHUB_TOKEN=ghp_your_token_here

# Optional: default headers for testing key-protected APIs
# e.g. HUGE_API_KEY=xxx then pass -H "X-Api-Key: $HUGE_API_KEY"

# Dashboard
API_HUNTER_HOST=127.0.0.1
API_HUNTER_PORT=8787
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787
